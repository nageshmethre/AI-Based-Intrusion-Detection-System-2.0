# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./backend/data/soc_ids.db

# Packet Capture Configuration
NETWORK_INTERFACE=
PROMISCUOUS_MODE=True
FLOW_TIMEOUT=5.0
FLOW_SWEEP_INTERVAL=1.0

# Detection & Model Configuration
MODEL_PATH=./backend/saved_models/random_forest_cicids2017.joblib
SCALER_PATH=./backend/saved_models/feature_scaler.joblib
METRICS_PATH=./backend/saved_models/model_metrics.json
ANOMALY_THRESHOLD=0.65

# Rule-based Thresholds
PORT_SCAN_THRESHOLD=15
PORT_SCAN_WINDOW_SECONDS=5.0
SYN_FLOOD_THRESHOLD=50
SSH_FAILURE_THRESHOLD=5
